---
/**
 * "Sign the manifesto" - form + signer wall.
 *
 * The wall is rendered entirely at BUILD TIME from `src/data/signers/*.json`, so it
 * needs no client JS, works with JS disabled, and cannot fail at runtime. The only
 * script is the form submit, which POSTs a handle to `/api/sign`; that function commits
 * a new signature file, and Vercel's auto-build on push turns the commit into a wall
 * entry roughly a minute later. The success copy says so rather than faking a live count.
 */
import Emoji from './Emoji.astro';
import {
  COZY_MAX,
  MAX_RENDERED,
  avatarUrl,
  formatCount,
  initials,
  profileUrl,
  safeLabel,
  type Signer,
} from './signManifesto';

interface Props {
  /** Anchor the "copy link to share" button points at; owned by the .mdx heading. */
  anchor?: string;
}
const { anchor = 'sign-the-manifesto' } = Astro.props;

/** One file per signer: the filename is the uniqueness constraint, so no dedupe here. */
const modules = import.meta.glob<Signer>('../data/signers/*.json', {
  eager: true,
  import: 'default',
});

// Tolerant of a missing `at`: hand-written signature files are exactly where that
// happens, and throwing here would fail the whole site build, not just this section.
const signers = Object.values(modules).sort((a, b) =>
  (b.at ?? '').localeCompare(a.at ?? ''),
);
const total = signers.length;
const shown = signers.slice(0, MAX_RENDERED);
const overflow = total - shown.length;
/** Few signatures look lonely in small pills; give them room instead. */
const cozy = total > 0 && total <= COZY_MAX;

const repoDir = 'https://github.com/am0wa/bakeit/tree/main/src/data/signers';
---

{/*
  `data-state` drives the whole form machine; panels are shown purely by CSS from it,
  and the server-rendered value is already correct so there is no flash on hydration.
  `not-content` opts this block out of Starlight's markdown styling in one move - every
  rule in markdown.css ends in `:not(:where(.not-content *))`.
*/}
<manifesto-signing
  id={anchor}
  class="not-content"
  data-state="idle"
  data-empty={total === 0 ? '' : undefined}
  data-cozy={cozy ? '' : undefined}
>
  <div class="ms-card">
    {/*
      No handle input, deliberately. The signer's identity comes from GitHub via OAuth,
      so there is nothing for a visitor to type - and nothing to impersonate with. This
      is a plain link, so it works with JS disabled too.
    */}
    <p class="ms-form">
      <a class="ms-btn" href="/api/sign" data-signin>
        Sign in with GitHub
        <Emoji icon="fountain-pen" monochrome={true} size="1.2em" />
      </a>
      {/* "Profile", not "name": the signature stores handle, numeric id, display name
          and timestamp - all public, but more than a name, so "only public name" would
          be an overclaim. */}
      <span class="ms-fine">
        Only Ur public profile, so we know U are U
      </span>
    </p>

    {/* Permanently in the DOM and empty, so role=alert announces on text insertion. */}
    <p class="ms-error" role="alert">
      <Emoji icon="warning" size="1.1em" />
      <span data-error></span>
    </p>

    <div class="ms-success" data-success>
      <p class="ms-success-title">
        <Emoji icon="party-popper" size="1.4em" />
        <span>U're in, <strong data-success-name></strong>!</span>
      </p>
      {/* Filled from the server's `message`: only it knows whether the signature was
          committed (live after the next build) or queued as a PR for review. */}
      <p class="ms-success-meta" data-success-meta></p>
    </div>

    <p class="ms-already" data-already>
      <Emoji icon="check-mark-button" size="1.2em" />
      {/* Server-driven: this panel is also how a still-open review PR is reported, so
          "already signed" must not be hardcoded here. */}
      <span data-already-msg></span>
    </p>

    {/* Never style this element: `.sr-only` lives in @layer starlight.utils and any
        unlayered position/size rule of ours would silently un-hide it. */}
    <p class="sr-only" role="status" aria-live="polite" data-status></p>
  </div>

  <section class="ms-wall" aria-labelledby="ms-wall-title">
    {/*
      The link is a SIBLING of the heading, not inside it: this h3 is the accessible
      name for both the wall section and the list below, so "on git" in there would be
      announced with every one of them.
    */}
    <div class="ms-wall-head">
      <h3 class="ms-wall-title" id="ms-wall-title">
        <Emoji icon="purple-heart" size="1.05em" />
        <span>Signed by<span class="ms-count"> <strong class="ms-count-num">{formatCount(total)}</strong> <span class="ms-count-label">{total === 1 ? 'person' : 'people'}</span></span></span>
      </h3>
      <a class="ms-git" href={repoDir}>
        on git
        {/* "on git" alone is meaningless in a screen reader's list of links. */}
        <span class="sr-only"> &mdash; every signature is a file in this repo</span>
      </a>
    </div>

    {
      total === 0 ? (
        <p class="ms-empty">
          <Emoji icon="fountain-pen" size="1.5em" />
          {/* Rendered at build time, so it cannot know a signature is pending review.
              The script rewrites it on a `queued` return - otherwise "be the first"
              sits directly under "U're in" and contradicts it. */}
          <span data-empty-msg>No signatures yet &mdash; be the first</span>
        </p>
      ) : (
        <ul class="ms-list" aria-labelledby="ms-wall-title">
          {shown.map((signer) => {
            const label = safeLabel(signer.name, signer.handle);
            return (
              <li class="ms-sig">
                <a class="ms-sig-link" href={profileUrl(signer.handle)}>
                  {/*
                    Initials sit BEHIND the avatar, so a deleted account (404 image)
                    reveals them with no onerror handler and no client JS.
                    referrerpolicy is not optional on the page that links to gdpr.eu:
                    without it, hotlinking leaks each visitor's IP and referring URL.
                  */}
                  <span class="ms-ava">
                    <span class="ms-ava-fallback" aria-hidden="true">{initials(label)}</span>
                    <img
                      class="ms-ava-img"
                      src={avatarUrl(signer.id, signer.handle)}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  </span>
                  <span class="ms-sig-name">{label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    {overflow > 0 && <p class="ms-rest">&hellip;and {formatCount(overflow)} more signers</p>}
  </section>
</manifesto-signing>

<style>
  /*
    Placement note: these rules live in a SCOPED <style>, which Astro emits UNLAYERED
    and after Starlight's `customCss`. Starlight's own styles sit inside
    @layer starlight.*, so everything here already wins on the cascade - `@layer
    components` (needed in src/tailwind.css) is unnecessary in this file.
  */

  manifesto-signing {
    /* Custom elements are display:inline by default. */
    display: grid;
    gap: 1.5rem;
    /* Starlight's sidebar appears at 50em, so the content column is narrower than the
       viewport and viewport media queries would lie. Measure the real box instead. */
    container-type: inline-size;

    /* Kept identical to Card.astro so the two never drift apart. */
    --ms-radius: 0.33rem;
    --ms-pad: clamp(1rem, calc(0.125rem + 3vw), 2rem);
    --ms-inset: var(--sl-color-gray-6);
  }

  /* ---------- card ---------- */
  .ms-card {
    display: grid;
    gap: 1rem;
    padding: var(--ms-pad);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--ms-radius);
    background-color: var(--sl-color-black);
    /* The site already says "important, and purple" with a thick inline-start edge on
       blockquotes (src/starlight.css). Reuse that idiom rather than inventing one. */
    border-inline-start: 4px solid var(--sl-color-purple);
    transition: border-inline-start-color 300ms ease;
  }
  [data-state='success'] .ms-card {
    border-inline-start-color: var(--sl-color-green);
  }

  .ms-wall-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: var(--sl-line-height-headings);
  }
  .ms-wall-title {
    font-size: var(--sl-text-h5);
  }

  /* ---------- count ---------- */
  /* Nothing signed yet: the empty panel says so, so "Signed by 0 people" is both
     redundant and deflating. Hidden, not omitted - the script needs the nodes. */
  [data-empty] .ms-count {
    display: none;
  }

  /* The count lives in the wall heading now: "Signed by 42 people". */
  .ms-count-num {
    color: var(--sl-color-text-accent);
    /* tabular-nums so a roll from 9 to 10 does not shift the label. */
    font-variant-numeric: tabular-nums;
  }
  .ms-count-label {
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }

  /* ---------- form ---------- */
  .ms-form {
    display: grid;
    gap: 0.9rem;
  }

  /* ---------- button ---------- */
  .ms-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Never shrink the label, and never let the row squash it. */
    flex: none;
    gap: 0.5rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: var(--ms-radius);
    background-color: var(--sl-color-accent);
    /* Tailwind's literal white token, NOT --sl-color-white, which flips to near-black
       in light mode and would be unreadable on violet. Still a token, not a hex. */
    color: var(--color-white);
    font-size: var(--sl-text-base);
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      transform 80ms ease,
      opacity 120ms ease;
  }
  .ms-btn:hover {
    background-color: var(--sl-color-accent-high);
  }
  .ms-btn:active {
    transform: translateY(1px);
  }
  .ms-btn:disabled,
  .ms-btn[aria-disabled='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .ms-fine {
    margin: 0;
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
  }

  /* ---------- error strip ---------- */
  .ms-error {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-red);
    border-radius: var(--ms-radius);
    background-color: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
    font-size: var(--sl-text-sm);
  }
  [data-state='error'] .ms-error {
    display: flex;
  }

  /* ---------- panel swap ---------- */
  .ms-success,
  .ms-already {
    display: none;
  }
  [data-state='success'] .ms-form,
  [data-state='already'] .ms-form {
    display: none;
  }
  [data-state='success'] .ms-success {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  [data-state='already'] .ms-already {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .ms-success-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
  }
  .ms-success-meta {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-state='success'] .ms-card {
      animation: ms-glow 900ms ease-out;
    }
  }
  @keyframes ms-glow {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--sl-color-accent) 55%, transparent);
    }
    to {
      box-shadow: 0 0 0 16px transparent;
    }
  }


  /* ---------- wall ---------- */
  .ms-wall {
    display: grid;
    gap: 0.75rem;
  }
  .ms-wall-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .ms-git {
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }
  .ms-git:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .ms-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    `:global()` because the client script clones chips at runtime and clones do not
    carry the astro-<hash> class; a fully scoped selector would style the SSR chips and
    silently miss every JS-created one. The scoped ancestor keeps the blast radius here.
  */
  .ms-list :global(.ms-sig) {
    --r: 0deg;
    /* "Signature" through geometry, not a typeface: italic, a hair of tracking, and a
       deterministic tilt. Zero network cost, identical on every platform - unlike the
       `cursive` keyword (Comic Sans on Windows) or a third-party font request. */
    transform: rotate(var(--r));
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }
  .ms-list :global(.ms-sig:nth-child(4n + 1)) {
    --r: -1.4deg;
  }
  .ms-list :global(.ms-sig:nth-child(4n + 2)) {
    --r: 0.9deg;
  }
  .ms-list :global(.ms-sig:nth-child(4n + 3)) {
    --r: -0.5deg;
  }
  .ms-list :global(.ms-sig:nth-child(4n)) {
    --r: 1.3deg;
  }
  .ms-list :global(.ms-sig:hover) {
    --r: 0deg; /* straightens on hover, so it is always readable */
  }

  .ms-list :global(.ms-sig-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.75rem 0.2rem 0.3rem;
    border: 1px solid var(--sl-color-purple);
    border-radius: 999px;
    background-color: var(--sl-color-purple-low);
    color: var(--sl-color-purple-high);
    font-size: var(--sl-text-base);
    font-style: italic;
    letter-spacing: 0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ms-list :global(.ms-sig-link:hover) {
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-accent-low);
  }

  .ms-list :global(.ms-ava) {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    background-color: var(--sl-color-purple);
    overflow: hidden;
    flex: none;
  }
  .ms-list :global(.ms-ava-fallback) {
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0;
  }
  .ms-list :global(.ms-ava-img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* Few signatures: bigger type and roomier pills, so the wall reads intimate not empty. */
  [data-cozy] .ms-list :global(.ms-sig-link) {
    font-size: var(--sl-text-lg);
    padding: 0.3rem 0.95rem 0.3rem 0.35rem;
  }
  [data-cozy] .ms-list :global(.ms-ava) {
    inline-size: 2.1rem;
    block-size: 2.1rem;
  }

  .ms-empty {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: var(--ms-radius);
    color: var(--sl-color-gray-2);
  }
  .ms-rest {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>

<script>
  import { must } from './signManifesto';

  /**
   * The OAuth callback sends the visitor back to this page with `?sign=<result>`, so all
   * this script does is turn that into a visible panel and tidy the URL. There is no
   * form to submit and no fetch: the sign-in control is a plain <a href="/api/sign">,
   * which is why the whole flow still works with JavaScript disabled.
   */
  type Result = 'queued' | 'signed' | 'already' | 'busy' | 'expired' | 'error';

  const OUTCOMES: Record<Result, { state: string; message: string }> = {
    // PR mode: nothing is on the wall until the PR is merged. Say so.
    queued: { state: 'success', message: 'Ur signature is queued for review' },
    // commit mode: it is on its way to the wall directly.
    signed: { state: 'success', message: 'Ur name joins the wall in about a minute' },
    already: { state: 'already', message: 'U already signed — thank U' },
    busy: {
      state: 'error',
      message: 'There are a lot of signatures awaiting review — try again in a bit',
    },
    expired: { state: 'error', message: 'That sign-in took too long — give it another go' },
    error: { state: 'error', message: 'Signing is having a moment — try again in a bit' },
  };

  const isResult = (v: string | null): v is Result => v !== null && v in OUTCOMES;

  class ManifestoSigning extends HTMLElement {
    #wired = false;

    // connectedCallback, not the constructor: a custom element constructor must not
    // inspect its children, and this can fire more than once.
    connectedCallback(): void {
      if (this.#wired) return;
      this.#wired = true;

      const params = new URLSearchParams(window.location.search);
      const result = params.get('sign');
      const handle = params.get('as');

      // Strip the result from the URL either way, so a refresh or a copied link does not
      // replay a stale outcome. Keep any hash so the anchor still works.
      if (params.has('sign')) {
        window.history.replaceState({}, '', window.location.pathname + window.location.hash);
      }

      // No result: this is a normal page view. The sign-in link needs no wiring.
      if (!isResult(result)) return;

      const { state, message } = OUTCOMES[result];
      this.dataset.state = state;

      // An empty wall says "be the first", which contradicts "queued for review" sitting
      // right above it. Only for `queued`: in commit mode (`signed`) the signature really
      // is on its way, and for `already`/errors nothing is pending. `querySelector`, not
      // `must()` - the node only exists while the wall is empty, so absence is normal.
      if (result === 'queued') {
        const empty = this.querySelector<HTMLElement>('[data-empty-msg]');
        if (empty) empty.textContent = 'Ur signature is first in line — it lands here once merged';
      }

      // Deliberately NO focus management. The visitor arrives here by navigation from
      // GitHub, so focus is already at the top of a fresh document and nothing was lost -
      // moving it would only draw the global :focus-visible ring around a panel they
      // never interacted with. The aria-live status below carries the outcome instead.
      // (Focusing was right when this panel replaced a form in place; it is not now.)

      if (state === 'success') {
        must<HTMLElement>(this, '[data-success-name]').textContent = handle ? `@${handle}` : '';
        must<HTMLElement>(this, '[data-success-meta]').textContent = message;
      } else if (state === 'already') {
        must<HTMLElement>(this, '[data-already-msg]').textContent = handle
          ? `@${handle} already signed — thank U`
          : message;
      } else {
        must<HTMLElement>(this, '[data-error]').textContent = message;
      }

      // Announce it once, for anyone not watching the panel appear.
      const status = must<HTMLElement>(this, '[data-status]');
      status.textContent = '';
      setTimeout(() => {
        // Messages carry no trailing punctuation, so join with a dash rather than
        // letting two sentences collide in the announcement.
        status.textContent = handle ? `${message} — signed as @${handle}` : message;
      }, 40);
    }
  }

  if (!customElements.get('manifesto-signing')) {
    customElements.define('manifesto-signing', ManifestoSigning);
  }
</script>
