---
/*@see https://docs.astro.build/en/guides/client-side-scripts/#pass-frontmatter-variables-to-scripts */
// @ts-ignore generated by typegen
import type { Icon as OneOfIcon } from "virtual:astro-icon";
import Card from './Card.astro';


interface Props {
  href?: string;
  icon?: string | OneOfIcon;
  wrapIcon?: boolean;
  title: string;
  monochrome?: boolean;
  clickable?: boolean;
  colour?: 'purple' | 'orange' | 'green' | 'red' | 'blue';
}

const { href, ...cardProps } = Astro.props;
---
<clickable-card data-href={href}>
    <Card {...cardProps} clickable={true}>{<slot />}</Card>
    <!-- `is:inline` keeps this script nested inside <clickable-card>. A bundled script is
         hoisted to a sibling position instead, which makes it a direct child of a wrapping
         <CardGrid> and shifts that grid's `:nth-child(2n)` stagger onto the wrong cards. -->
    <script is:inline>
      if (!customElements.get('clickable-card')) {
        customElements.define(
          'clickable-card',
          class ClickableCard extends HTMLElement {
            // Bind here, not in the constructor: only card 1 is upgraded (the defining script
            // lives inside it) — cards 2..n run their constructor at the start tag, before any
            // child or attribute exists, so querySelector/dataset come back empty.
            connectedCallback() {
              if (this._bound) return; // re-fires if the node is moved.
              this._bound = true;

              // Delegate on the host: nothing to query, and href is read at click time.
              this.addEventListener('click', (event) => {
                if (event.target.closest('a')) return; // a real link inside wins.
                const href = this.dataset.href;
                if (href) {
                  window.location.href = href;
                }
              });
            }
          }
        );
      }
    </script>
</clickable-card>

